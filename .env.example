# Optional environment variables (export them before starting the server) to override defaults.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Shared cache for multi-server deployments (otherwise a local file cache is used)
# REDIS_URL=redis://localhost:6379/0

# Routing
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15

# Vehicle / planner defaults
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
STOP_PENALTY_DOLLARS=10
CORRIDOR_MILES=10
API_RATE_LIMIT=600/min
